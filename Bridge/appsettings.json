  "Engine": {
    "Path": "",
    "Name": "Chess Engine",
    "Ponder": true,
    "MoveOverheadMilliseconds": 0,
    "SearchStatusPollMilliseconds": 1000,
    "StartupCommands": []
  },
  "AutoBotChallenge": {
    "Enabled": false,
    "IdleDelaySeconds": 30,
    "ChallengeTimeoutSeconds": 5,
    "OnlineBotsCacheSeconds": 300,
    "OpponentCooldownMinutes": 60,
    "DeclineHistoryRetentionHours": 24,
    "AutoChallengeStatePath": "data/auto-bot-challenge-state.json",
    "AllowList": [],
    "BlockList": [],
    "MinRating": 1850,
    "MaxRating": null,
    "MaxRatingDifference": 300,
    "Profiles": [
      {
        "Enabled": false,
        "Name": "Rated Bullet",
        "Mode": "rated",
        "Variant": "standard",
        "InitialSeconds": 60,
        "IncrementSeconds": 0
      },
      {
        "Enabled": true,
        "Name": "Rated Blitz",
        "Mode": "rated",
        "Variant": "standard",
        "InitialSeconds": 300,
        "IncrementSeconds": 3
      },
      {
        "Enabled": false,
        "Name": "Rated Rapid",
        "Mode": "rated",
        "Variant": "standard",
        "InitialSeconds": 900,
        "IncrementSeconds": 10
      }
    ]
  },
  "Games": {
    "PgnPath": "data/games.pgn",
    "AbortIfNoMoveSeconds": 60
  },
  "Chat": {
    "StartMessage": "Good luck, and have fun!",
    "EndMessage": "Thanks for the game!"
  },
  "Logging": {
    "FilePath": "data/lichessbridge.log",
    "ConsoleEntries": 30,
    "ConsoleLogLevel": "Information",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "LichessBridge.Engine.WinBoardEngine": "Debug",
      "LichessBridge.Lichess.LichessClient": "Debug"
    }
