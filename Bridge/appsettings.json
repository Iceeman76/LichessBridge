{
  "Lichess": {
    "BaseUri": "https://lichess.org",
    "ChallengeFilter": {
      "Modes": [ "rated" ],
      "Opponents": [ "human", "bot" ],
      "Variants": [ "standard" ],
      "Speeds": [ "bullet", "blitz", "rapid" ],
      "MinBaseSeconds": 0,
      "MaxBaseSeconds": 10800,
      "MinIncrementSeconds": 0,
      "MaxIncrementSeconds": 180,
      "MinRating": null,
      "MaxRating": null,
      "MaxRatingDifference": null,
      "AllowList": [],
      "BlockList": [],
      "MaxSimultaneousGamesPerUser": 1,
      "BulletRequiresIncrement": false
    }
  },
  "Engine": {
    "Path": "",
    "Name": "Chess Engine",
    "Ponder": true,
    "MoveOverheadMilliseconds": 0,
    "SearchStatusPollMilliseconds": 1000,
    "StartupCommands": []
  },
  "AutoBotChallenge": {
    "Enabled": false,
    "IdleDelaySeconds": 60,
    "ChallengeTimeoutSeconds": 30,
    "OnlineBotsCacheSeconds": 900,
    "OpponentCooldownMinutes": 300,
    "DeclineHistoryRetentionHours": 120,
    "AutoChallengeStatePath": "data/auto-bot-challenge-state.json",
    "AllowList": [],
    "BlockList": [],
    "MinRating": null,
    "MaxRating": null,
    "MaxRatingDifference": 300,
    "Profiles": [
      {
        "Enabled": true,
        "Name": "Bullet",
        "Mode": "rated",
        "Variant": "standard",
        "InitialSeconds": 60,
        "IncrementSeconds": 0
      },
      {
        "Enabled": true,
        "Name": "Blitz",
        "Mode": "rated",
        "Variant": "standard",
        "InitialSeconds": 180,
        "IncrementSeconds": 0
      },
      {
        "Enabled": true,
        "Name": "Rapid",
        "Mode": "rated",
        "Variant": "standard",
        "InitialSeconds": 600,
        "IncrementSeconds": 0
      }
    ]
  },
  "Games": {
    "PgnPath": "data/games.pgn",
    "AbortIfNoMoveSeconds": 60
  },
  "Chat": {
    "StartMessage": "Good luck, and have fun!",
    "EndMessage": "Thanks for the game!"
  },
  "Logging": {
    "FilePath": "data/lichessbridge.log",
    "ConsoleEntries": 30,
    "ConsoleLogLevel": "Information",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "LichessBridge.Engine.WinBoardEngine": "Information",
      "LichessBridge.Lichess.LichessClient": "Information"
    }
  }
}
