<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
    <RootNamespace>DotNetLab.LichessBridge.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LichessBridge\LichessBridge.csproj" />
    <ProjectReference Include="..\LichessBridge.TestEngine\LichessBridge.TestEngine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyTestEngine" AfterTargets="Build">
    <ItemGroup>
      <TestEngineFiles Include="..\LichessBridge.TestEngine\bin\$(Configuration)\net10.0\LichessBridge.TestEngine*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestEngineFiles)" DestinationFolder="$(OutDir)TestEngine" SkipUnchangedFiles="true" />
  </Target>
</Project>
